# Mobile env (Expo). Copy to .env for local dev; .env is gitignored.
#
# Backend base URL. apiClient.tsx defaults to production
# (https://api.kiruko.mu/api/v1) when this is unset, and EAS build profiles
# (eas.json) set it for preview/production builds. For local dev, point it at
# your ngrok tunnel or LAN IP:
#   EXPO_PUBLIC_API_URL=https://<your-tunnel>/api/v1
EXPO_PUBLIC_API_URL=

# PostHog analytics (mobile). The project API key is public (embedded in the
# client) — safe to commit, but leave blank locally to avoid sending dev
# events. When blank, the SDK is disabled (see app/_layout.tsx). For EAS
# preview/production builds, set EXPO_PUBLIC_POSTHOG_API_KEY as an EAS env var.
#   Project API key: PostHog -> Project settings (starts with "phc_")
#   Host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
