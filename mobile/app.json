{
  "expo": {
    "name": "Kiruko",
    "slug": "kiruko-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kiruko-icon.png",
    "scheme": "kiruko",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mu.kiruko.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "U29MDGMN4R"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kiruko-adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kiruko.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.kiruko.mu", "pathPrefix": "/claim" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/kiruko-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kiruko-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kiruko Kiosk takes a quick photo when an employee clocks in. This deters someone else from using a coworker's PIN.",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kiruko lets you attach a photo from your library — for example a receipt or your profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kiruko records your location when you clock in to confirm you're at your workplace."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kiruko uses Face ID to quickly and securely unlock your account."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/kiruko-mark.png",
          "color": "#F2B705"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "./plugins/withFmtConstevalFix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f149cde8-905e-41b2-9d24-4fe7c4f886e1"
      }
    },
    "owner": "kirukos-team",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f149cde8-905e-41b2-9d24-4fe7c4f886e1"
    }
  }
}
