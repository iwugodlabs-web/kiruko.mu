# Railway deployment template for the Ivor backend.
# Copy these values into your Railway backend service variables.
# NEVER commit real secrets to git.

# ── Database (from Railway Postgres service) ───────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_SSLMODE=require

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_64_char_hex_string
JWT_ALGORITHM=HS256

# ── Admin ──────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=iwugodlabs@gmail.com
SUPER_USER_EMAIL=iwugodlabs@gmail.com
SUPER_USER_PASSWORD=replace_with_strong_password

# ── CORS ───────────────────────────────────────────────────────────────────
# Add your deployed web URL and any mobile dev origins.
CORS_ORIGINS=https://your-web.up.railway.app,http://localhost:3000

# ── Email (SendGrid example) ───────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_with_sendgrid_api_key
SMTP_FROM_EMAIL=iwugodlabs@gmail.com

# ── Frontend URL (used in invite/claim/payslip email links) ────────────────
FRONTEND_URL=https://your-web.up.railway.app

# ── Storage ────────────────────────────────────────────────────────────────
# WARNING: local storage is ephemeral on Railway. Use s3 or gcs for production.
STORAGE_TYPE=local

# AWS S3 (required if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Google Cloud Storage (required if STORAGE_TYPE=gcs)
GCS_BUCKET_NAME=

# ── Misc ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_NAME=Kiruko
TIME_ZONE_LOCAL=Indian/Mauritius
INVITE_EXPIRY_DAYS=7
ESTIMATED_PAYSLIP_ENABLED=false
