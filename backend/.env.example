# ─────────────────────────────────────────────────────────────
# Ivor Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Generate a new JWT_SECRET with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ivor_db
POSTGRES_SSLMODE=disable
TIME_ZONE_LOCAL=Indian/Mauritius

# Auth — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_64_char_hex_string
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=replace_with_base64_key

APP_NAME=Kiruko
ENVIRONMENT=development

# Admin
SUPER_ADMIN_EMAILS=admin@yourdomain.com
SUPER_USER_EMAIL=admin@yourdomain.com
SUPER_USER_PASSWORD=replace_with_strong_password

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email — choose one option below
# Option 1: SendGrid (recommended)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Option 2: SMTP (Gmail, Mailtrap, etc.)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=hello@kiruko.mu

# Invite expiry
INVITE_EXPIRY_DAYS=7

# Frontend — base URL used to build email links (account-claim, invites, etc.).
# PROD: set FRONTEND_URL=https://app.kiruko.mu in the DigitalOcean backend
# component, or claim/invite emails will point at localhost.
FRONTEND_URL=http://localhost:3000

# Storage: local | s3 | gcs
STORAGE_TYPE=local

# AWS S3 / S3-compatible (required if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=your_region
S3_BUCKET_NAME=your_bucket_name
# Optional: custom endpoint for S3-compatible stores (e.g. DigitalOcean Spaces:
# https://<region>.digitaloceanspaces.com). Leave empty for real AWS S3.
AWS_S3_ENDPOINT_URL=

# Google Cloud Storage (required if STORAGE_TYPE=gcs)
GCS_BUCKET_NAME=your_gcs_bucket_name
# M4 — gate the estimated payslip endpoint. Default false in production
# until counsel reviews the EN/FR/MG disclaimer translations.
ESTIMATED_PAYSLIP_ENABLED=true

# Platform bootstrap: comma-separated platform admin emails (used by seed script)
SUPER_ADMIN_EMAILS=""
SUPER_USER_PASSWORD=

GOOGLE_APPLICATION_CREDENTIALS=./kontokas-bd125ce55c97.json

# Document AI — receipt/expense parsing. When enabled, /purchases/scan
# routes through the Expense Parser processor; falls back to Cloud Vision
# heuristics on error or low confidence. Reuses GOOGLE_APPLICATION_CREDENTIALS;
# the service account needs the "Document AI API User" role.
DOC_AI_ENABLED=true
# Shadow mode logged Doc AI output for comparison but returned the heuristic
# result to clients. Switching to live so the structured Doc AI extraction
# (merchant + per-item amounts + currency + confidence) reaches mobile. The
# heuristic now only runs as fallback on Doc AI error or confidence below
# DOC_AI_MIN_CONFIDENCE.
DOC_AI_SHADOW_MODE=false
DOC_AI_PROJECT_ID=kontokas
DOC_AI_LOCATION=us
DOC_AI_EXPENSE_PROCESSOR_ID=
DOC_AI_MIN_CONFIDENCE=0.7
ENABLED_KINDS=employer,house,ad
PLATFORM_PERM_ENFORCEMENT=false
CLICK_HOST_ALLOWLIST=localhost

# --- Phone OTP login ---
# Delivery provider: console | whatsapp_meta | twilio_sms
# `console` logs codes in plaintext (dev/CI only) and is REFUSED when
# ENVIRONMENT=production. Set a real provider before deploying.
OTP_PROVIDER=console

# WhatsApp (Meta) provider — required when OTP_PROVIDER=whatsapp_meta
META_WA_PHONE_NUMBER_ID=
META_WA_TOKEN=
META_WA_TEMPLATE_NAME=kiruko_login_otp
META_WA_API_VERSION=v21.0

# Twilio SMS provider — required when OTP_PROVIDER=twilio_sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Dev/testing only: enables the whole-run payroll Redo (off in prod).
ENABLE_PAYROLL_REDO=false
